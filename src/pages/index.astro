---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SetPiece from '../components/SetPiece.tsx';
import type { SiteCell } from '../content/schemas';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const cards = (await getCollection('cards')).sort((a, b) => a.data.order - b.data.order);
const sources = (await getCollection('sources'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({ id: entry.id, label: entry.data.label, image: entry.data.image }));

const siteCells = await getCollection('site');
function cellData<T extends SiteCell['cell']>(cell: T): Extract<SiteCell, { cell: T }> {
	const entry = siteCells.find((e) => e.data.cell === cell);
	if (!entry) throw new Error(`Missing site cell: ${cell}`);
	return entry.data as Extract<SiteCell, { cell: T }>;
}

const hero = cellData('hero');
const about = cellData('about');
const experience = cellData('experience');
const now = cellData('now');
const design = cellData('design');
const stack = cellData('stack');
const contact = cellData('contact');
---

<BaseLayout title="Jitheswar">
	<main class="p-6 sm:p-10">
		<div data-bento-grid class="grid grid-cols-2 gap-6 md:grid-cols-4">
			<div
				data-bento-cell
				class="clay col-span-2 row-span-1 flex flex-col items-start justify-center gap-6 p-10 md:col-span-2 md:row-span-2"
			>
				<h1 class="carve font-display text-4xl font-semibold sm:text-5xl">{hero.name}</h1>
				<p class="text-lg text-ink sm:text-xl">{hero.line}</p>
				<a href={hero.ctaHref} class="clay clay-pressable text-base font-medium px-5 py-3">
					{hero.ctaLabel}
				</a>
			</div>

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-2">
				<h2 class="carve font-display text-xl font-semibold">Experience</h2>
				<p class="text-base text-ink">
					{experience.role}, {experience.employer} - {experience.dates}. {experience.summary} {experience.metric}.
				</p>
			</div>

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-3 p-6 md:col-span-2">
				<h2 class="carve font-display text-xl font-semibold">Source</h2>
				<p class="text-base text-ink">Choose a Source and the page takes its colour from it.</p>
				<SetPiece client:idle={{ timeout: 1000 }} sources={sources} />
			</div>

			{
				caseStudies.map((entry) => (
					<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-2">
						<h2 class="carve font-display text-xl font-semibold">{entry.data.title}</h2>
						<p class="text-base text-ink">{entry.data.claim}</p>
						{entry.data.headlineMetric && <p class="text-sm text-ink">{entry.data.headlineMetric}</p>}
						<a
							href={`/case-studies/${entry.id}/`}
							class="clay clay-pressable self-start text-sm font-medium px-4 py-2"
						>
							Read the Case Study
						</a>
					</div>
				))
			}

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">About</h2>
				<p class="text-base text-ink">{about.text}</p>
			</div>

			<div data-bento-cell class="clay col-span-1 flex flex-col gap-2 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">Now</h2>
				<p class="text-base text-ink">{now.text}</p>
			</div>

			<div data-bento-cell class="clay col-span-1 flex flex-col gap-3 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">Design</h2>
				<p class="text-base text-ink">{design.intro}</p>
				<ul class="flex list-none flex-col gap-2 p-0">
					{
						design.themes.map((theme) => (
							<li class="flex flex-col gap-0.5">
								<span class="text-sm font-medium text-ink">{theme.name}</span>
								<p class="text-sm text-ink">{theme.description}</p>
							</li>
						))
					}
				</ul>
			</div>

			{
				cards.map((entry) => (
					<div data-bento-cell class="clay col-span-1 flex flex-col gap-2 p-6 md:col-span-1">
						<h2 class="carve font-display text-xl font-semibold">{entry.data.title}</h2>
						<p class="text-base text-ink">{entry.data.claim}</p>
						<a
							href={entry.data.sourceUrl}
							class="clay clay-pressable self-start text-sm font-medium px-4 py-2"
						>
							Source
						</a>
					</div>
				))
			}

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-2">
				<h2 class="carve font-display text-xl font-semibold">Stack</h2>
				<ul class="flex list-none flex-wrap gap-2 p-0">
					{
						stack.items.map((item) => (
							<li class="clay px-3 py-1 text-sm text-ink">{item}</li>
						))
					}
				</ul>
			</div>

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-3 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">Contact</h2>
				<div class="flex flex-wrap gap-2">
					<a
						href={`mailto:${contact.email}`}
						class="clay clay-pressable text-base font-medium px-5 py-3"
					>
						Email
					</a>
					<a href={contact.github} class="clay clay-pressable text-base font-medium px-5 py-3">
						GitHub
					</a>
					<a href={contact.linkedin} class="clay clay-pressable text-base font-medium px-5 py-3">
						LinkedIn
					</a>
					<a href={contact.resumeHref} class="clay clay-pressable text-base font-medium px-5 py-3">
						Resume
					</a>
				</div>
			</div>
		</div>
	</main>
</BaseLayout>
