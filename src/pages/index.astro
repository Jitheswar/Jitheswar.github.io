---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SetPiece from '../components/SetPiece.tsx';

const heroLine = 'I build systems, then defend every decision in them under questioning.';

const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const cards = (await getCollection('cards')).sort((a, b) => a.data.order - b.data.order);
const sources = (await getCollection('sources'))
	.sort((a, b) => a.data.order - b.data.order)
	.map((entry) => ({ id: entry.id, label: entry.data.label, image: entry.data.image }));
---

<BaseLayout title="Jitheswar">
	<main class="p-6 sm:p-10">
		<div data-bento-grid class="grid grid-cols-2 gap-6 md:grid-cols-4">
			<div
				data-bento-cell
				class="clay col-span-2 row-span-1 flex flex-col items-start justify-center gap-6 p-10 md:col-span-2 md:row-span-2"
			>
				<h1 class="carve font-display text-4xl font-semibold sm:text-5xl">Jitheswar</h1>
				<p class="text-lg text-ink sm:text-xl">{heroLine}</p>
				<a href="https://github.com/Jitheswar" class="clay clay-pressable text-base font-medium px-5 py-3">
					GitHub
				</a>
			</div>

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-2">
				<h2 class="carve font-display text-xl font-semibold">Experience</h2>
				<p class="text-base text-ink">
					Research Software Engineer Intern, DigiClinics - Feb to Aug 2026. Built a plant and herb
					classification pipeline combining TF-IDF retrieval with INT8 quantization for on-device inference,
					cross-validation 0.9864.
				</p>
			</div>

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-3 p-6 md:col-span-2">
				<h2 class="carve font-display text-xl font-semibold">Source</h2>
				<p class="text-base text-ink">Choose a Source and the page takes its colour from it.</p>
				<SetPiece client:idle={{ timeout: 1000 }} sources={sources} />
			</div>

			{
				caseStudies.map((entry) => (
					<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-2">
						<h2 class="carve font-display text-xl font-semibold">{entry.data.title}</h2>
						<p class="text-base text-ink">{entry.data.claim}</p>
						{entry.data.headlineMetric && <p class="text-sm text-ink">{entry.data.headlineMetric}</p>}
						<a
							href={`/case-studies/${entry.id}/`}
							class="clay clay-pressable self-start text-sm font-medium px-4 py-2"
						>
							Read the Case Study
						</a>
					</div>
				))
			}

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">About</h2>
				<p class="text-base text-ink">Computer science undergraduate, graduating 2028.</p>
			</div>

			<div data-bento-cell class="clay col-span-1 flex flex-col gap-2 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">Now</h2>
				<p class="text-base text-ink">Building this site.</p>
			</div>

			<div data-bento-cell class="clay col-span-1 flex flex-col gap-2 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">Design</h2>
				<p class="text-base text-ink">Two Omarchy themes, presented as visual work.</p>
			</div>

			{
				cards.map((entry) => (
					<div data-bento-cell class="clay col-span-1 flex flex-col gap-2 p-6 md:col-span-1">
						<h2 class="carve font-display text-xl font-semibold">{entry.data.title}</h2>
						<p class="text-base text-ink">{entry.data.claim}</p>
						<a
							href={entry.data.sourceUrl}
							class="clay clay-pressable self-start text-sm font-medium px-4 py-2"
						>
							Source
						</a>
					</div>
				))
			}

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-2 p-6 md:col-span-2">
				<h2 class="carve font-display text-xl font-semibold">Stack</h2>
				<p class="text-base text-ink">TypeScript, Python, Kubernetes, and more.</p>
			</div>

			<div data-bento-cell class="clay col-span-2 flex flex-col gap-3 p-6 md:col-span-1">
				<h2 class="carve font-display text-xl font-semibold">Contact</h2>
				<a
					href="mailto:2420030078cse@gmail.com"
					class="clay clay-pressable self-start text-base font-medium px-5 py-3"
				>
					Email
				</a>
			</div>
		</div>
	</main>
</BaseLayout>
